# Optional overrides for docker compose (copy to `.env` next to docker-compose.yml):
#   GATEWAY_HOST_PORT=8080
#   BACKEND_HOST_PORT=3000
#   POSTGRES_PASSWORD=postgres
#   REDIS_PASSWORD=redispass
#   RUN_MIGRATIONS=true
#   RUN_SEEDS=true
#
# Hybrid (`make infra`) publishes db/redis via docker-compose.infra.yml:
#   POSTGRES_HOST_PORT=25432
#   REDIS_HOST_PORT=6379

GATEWAY_HOST_PORT=8080
BACKEND_HOST_PORT=3000
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=6379
POSTGRES_DB=mfe_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redispass
RUN_MIGRATIONS=true
RUN_SEEDS=true
