# Caddyfile.compose — used by root docker-compose.yml
# FE services are production static (Caddy :80). Backend is Nest :3000.
# Browser origin: http://localhost:8080 → gateway :80

:80 {

  handle /api* {
    reverse_proxy backend:3000
  }

  # Vite/prod base="/app/" — bare /app breaks asset resolution
  redir /app /app/ 308

  handle /app* {
    reverse_proxy shell:80
  }

  handle /r/demo-react* {
    reverse_proxy demo-react:80
  }

  handle /r/admin-react* {
    reverse_proxy admin-react:80
  }

  handle {
    reverse_proxy landing:80
  }
}
