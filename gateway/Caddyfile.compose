# Caddyfile.compose — used by root docker-compose.yml
# Upstreams are Docker Compose service DNS names (same network).
# Browser origin: http://localhost:8080 → container :80

:80 {

  handle /api* {
    reverse_proxy backend:3000
  }

  # Vite base="/app/" — bare /app breaks asset resolution
  redir /app /app/ 308

  handle /app* {
    reverse_proxy shell:5174
  }

  handle /r/demo-react* {
    reverse_proxy demo-react:5175
  }

  handle /r/admin-react* {
    reverse_proxy admin-react:5176
  }

  handle {
    reverse_proxy landing:5173
  }
}
