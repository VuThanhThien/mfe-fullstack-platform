{
  "name": "@mfe/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared SDK for MFE platform — auth, API wrapper, remote loader",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react-router": {
      "types": "./src/react-router/index.ts",
      "import": "./src/react-router/index.ts",
      "default": "./src/react-router/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.12.2",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@module-federation/enhanced": "^2.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@module-federation/enhanced": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
