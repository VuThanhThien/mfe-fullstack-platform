{
  "name": "@mfe/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared SDK for MFE platform — auth, API wrapper, remote loader",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{ts,mjs,json}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.12.2",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "@module-federation/enhanced": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@module-federation/enhanced": {
      "optional": true
    }
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
