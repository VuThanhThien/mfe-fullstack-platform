:80 {
	root * /srv
	encode gzip
	handle_path /r/admin-react* {
		root * /srv

		@entry path /mf-manifest.json /remoteEntry.js /remoteEntry.ssr.js
		header @entry Cache-Control "no-store, must-revalidate"

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		file_server
	}
	handle {
		redir /r/admin-react/ 302
	}
}
