:80 {
	root * /srv
	encode gzip
	handle_path /r/demo-react* {
		root * /srv

		# Entrypoints: stable URLs, content changes every deploy — never cache.
		@entry path /mf-manifest.json /remoteEntry.js /remoteEntry.ssr.js
		header @entry Cache-Control "no-store, must-revalidate"

		# Hashed Vite/MF chunks — safe to cache forever.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		file_server
	}
	handle {
		redir /r/demo-react/ 302
	}
}
